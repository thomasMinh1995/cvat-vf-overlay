diff --git a/cvat-canvas3d/src/typescript/vfEgoVehicle.ts b/cvat-canvas3d/src/typescript/vfEgoVehicle.ts
new file mode 100644
index 0000000..248c152
--- /dev/null
+++ b/cvat-canvas3d/src/typescript/vfEgoVehicle.ts
@@ -0,0 +1,227 @@
+// Displays an illustrative rig in VF LiDAR coordinates: +X left, +Y rear, +Z up.
+import * as THREE from 'three';
+
+export const VF_EGO_VEHICLE = 'vf-ego-vehicle';
+export const VF_EGO_CAMERAS = 'vf-ego-cameras';
+
+const BODY_HEIGHT = -0.7;
+const FRONT_COLOR = 0xffd166;
+const AXIS_LABEL_HEIGHT = 24;
+const CAMERA_LABEL_HEIGHT = 18;
+const AXIS_COLORS = ['#ffa291', '#a8ed80', '#89d4ff'];
+
+// Illustrative mounts and headings for the public overlay.
+const CAMERA_LAYOUT = [
+    { name: 'cam01', origin: [-0.25, -0.8, -0.4], angle: 0 },
+    { name: 'cam03', origin: [0.25, -0.8, -0.4], angle: 5 },
+    { name: 'cam05', origin: [0.8, -0.9, -0.7], angle: 135 },
+    { name: 'cam06', origin: [0.8, 0.9, -0.7], angle: 60 },
+    { name: 'cam07', origin: [-0.8, 0.9, -0.7], angle: -60 },
+    { name: 'cam08', origin: [-0.8, -0.9, -0.7], angle: -135 },
+    { name: 'cam09', origin: [0, 1.5, -0.7], angle: 180 },
+] as const;
+
+function flatShape(points: [number, number][], color: number, opacity = 1): THREE.Mesh {
+    const path = new THREE.Shape(points.map(([x, y]) => new THREE.Vector2(x, y)));
+    return new THREE.Mesh(new THREE.ShapeGeometry(path), new THREE.MeshBasicMaterial({
+        color, opacity, transparent: opacity < 1, depthWrite: false, side: THREE.DoubleSide,
+    }));
+}
+
+function createLabel(
+    text: string, color: string, heightPx: number, cameraLabel = false,
+    layout?: { readText?: () => string; arrowOrigin: THREE.Vector3 },
+): THREE.Sprite {
+    const canvas = document.createElement('canvas');
+    const context = canvas.getContext('2d')!;
+    const fontForLine = (index: number): string => `bold ${layout?.readText && index === 1 ? 40 : 32}px sans-serif`;
+    const lines = text.split('\n');
+    const lineWidths = lines.map((line, index) => {
+        context.font = fontForLine(index);
+        return context.measureText(line).width;
+    });
+    canvas.width = Math.ceil(Math.max(...lineWidths)) + 36;
+    canvas.height = 16 + lines.length * 48;
+
+    function paintLabel(value: string): void {
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        context.fillStyle = '#171b21';
+        context.beginPath();
+        context.roundRect(0, 0, canvas.width, canvas.height, 16);
+        context.fill();
+        context.fillStyle = color;
+        context.textAlign = 'center';
+        context.textBaseline = 'middle';
+        value.split('\n').forEach((line, index) => {
+            context.font = fontForLine(index);
+            context.fillText(line, canvas.width / 2, 32 + index * 48);
+        });
+    }
+
+    let displayedText = layout?.readText?.() ?? text;
+    paintLabel(displayedText);
+    const texture = new THREE.CanvasTexture(canvas);
+    texture.colorSpace = THREE.SRGBColorSpace;
+    const label = new THREE.Sprite(new THREE.SpriteMaterial({
+        map: texture, sizeAttenuation: false, depthWrite: false, depthTest: false,
+    }));
+    label.center.set(0.5, 0);
+    const aspect = canvas.width / canvas.height;
+    const projectedOrigin = layout && new THREE.Vector3();
+    const projectedTip = layout && new THREE.Vector3();
+    label.onBeforeRender = (renderer, _scene, camera) => {
+        const nextText = layout?.readText?.();
+        if (nextText !== undefined && nextText !== displayedText) {
+            displayedText = nextText;
+            paintLabel(nextText);
+            texture.needsUpdate = true;
+        }
+
+        const projectionScale = renderer.domElement.clientHeight * camera.projectionMatrix.elements[5] / 2;
+        if (projectionScale <= 0) return;
+
+        // Three.js sprites with sizeAttenuation disabled use projected viewport units.
+        const scale = heightPx / projectionScale;
+        if (label.scale.y !== scale) {
+            label.scale.set(scale * aspect, scale, 1);
+            label.updateMatrixWorld();
+        }
+
+        if (layout && projectedOrigin && projectedTip) {
+            projectedOrigin.copy(layout.arrowOrigin).project(camera);
+            projectedTip.copy(label.position).project(camera);
+            const dx = (projectedTip.x - projectedOrigin.x) * renderer.domElement.clientWidth;
+            const dy = (projectedTip.y - projectedOrigin.y) * renderer.domElement.clientHeight;
+            const length = Math.hypot(dx, dy);
+
+            // Put the entire badge beyond the arrow tip in screen space, with a five-pixel gap.
+            const directionX = length > 0 ? dx / length : 0;
+            const directionY = length > 0 ? dy / length : 1;
+            const widthPx = heightPx * aspect;
+            const offset = (Math.abs(directionX) * widthPx + Math.abs(directionY) * heightPx) / 2 + 5;
+            label.center.set(0.5 - directionX * offset / widthPx, 0.5 - directionY * offset / heightPx);
+        }
+
+        if (cameraLabel) {
+            const pixelsPerMetre = projectionScale / label.position.distanceTo(camera.position);
+            label.material.opacity = THREE.MathUtils.clamp((pixelsPerMetre - 12) / 12, 0, 1);
+        }
+    };
+    return label;
+}
+
+function createCameras(): THREE.Group {
+    const rig = new THREE.Group();
+    rig.name = VF_EGO_CAMERAS;
+    const opticalAxis = new THREE.Vector3(0, 0, 1);
+    for (const { name, origin, angle } of CAMERA_LAYOUT) {
+        const position = new THREE.Vector3(...origin);
+        const yaw = THREE.MathUtils.degToRad(angle);
+        const direction = new THREE.Vector3(Math.sin(yaw), -Math.cos(yaw), 0);
+        const color = direction.y < 0 ? '#77ddc1' : '#ff9f76';
+        const housing = new THREE.Mesh(
+            new THREE.BoxGeometry(0.16, 0.12, 0.15),
+            new THREE.MeshBasicMaterial({ color }),
+        );
+        housing.name = name;
+        housing.position.copy(position);
+        housing.quaternion.setFromUnitVectors(opticalAxis, direction);
+
+        const length = 0.65;
+        const ray = new THREE.ArrowHelper(direction, position, length, color, 0.17, 0.11);
+        const label = createLabel(name, color, CAMERA_LABEL_HEIGHT, true);
+        label.position.copy(position).addScaledVector(direction, length);
+        // The two forward cameras sit close together and their optical axes are nearly parallel.
+        if (name === 'cam01') label.center.set(0, 1);
+        if (name === 'cam03') label.center.set(1, 0);
+        rig.add(housing, ray, label);
+    }
+    return rig;
+}
+
+export function createVfCuboidAxisLabels(): {
+    group: THREE.Group;
+    setOrientation: (cuboid: THREE.Mesh, frontArrow: THREE.ArrowHelper, showVehicleEnds: boolean) => void;
+} {
+    const labels = new THREE.Group();
+    labels.visible = false;
+    let yawTenths = 0;
+    let frontTitle = 'Cuboid +X';
+    const arrowOrigin = new THREE.Vector3();
+    const rearOrigin = new THREE.Vector3();
+    const yawLabel = createLabel('Cuboid +X · ĐẦU XE\nYaw VF 000.0°', AXIS_COLORS[0], 39, false, {
+        readText: () => `${frontTitle}\nYaw VF ${(yawTenths / 10).toFixed(1)}°`,
+        arrowOrigin,
+    });
+    const rearLabel = createLabel('Cuboid −X · ĐUÔI XE', '#f2d28f', 23, false, { arrowOrigin: rearOrigin });
+    // Keep the selected yaw above fixed LiDAR labels when they overlap on screen.
+    yawLabel.renderOrder = 1;
+    labels.add(
+        yawLabel,
+        createLabel('Cuboid +Y', AXIS_COLORS[1], 22),
+        createLabel('Cuboid +Z', AXIS_COLORS[2], 22),
+        rearLabel,
+    );
+    return {
+        group: labels,
+        setOrientation: (cuboid, frontArrow, showVehicleEnds) => {
+            const yawDegrees = THREE.MathUtils.radToDeg(cuboid.rotation.z);
+            yawTenths = THREE.MathUtils.euclideanModulo(Math.round(yawDegrees * 10), 3600);
+            frontTitle = showVehicleEnds ? 'Cuboid +X · ĐẦU XE' : 'Cuboid +X';
+            frontArrow.getWorldPosition(arrowOrigin);
+            frontArrow.cone.getWorldPosition(yawLabel.position);
+
+            rearLabel.visible = showVehicleEnds;
+            if (showVehicleEnds) {
+                cuboid.getWorldPosition(rearOrigin);
+                cuboid.localToWorld(rearLabel.position.set(-0.5, 0, 0));
+            }
+        },
+    };
+}
+
+export function createVfEgoVehicle(axisOrigin: THREE.Vector3, axisLength: number): THREE.Group {
+    const group = new THREE.Group();
+    group.name = VF_EGO_VEHICLE;
+
+    // Approximate footprint about the roof-mounted LiDAR, in metres.
+    const outline: [number, number][] = [
+        [-0.62, -2.22], [0.62, -2.22], [0.93, -1.8], [0.93, 1.77],
+        [0.65, 2.05], [-0.65, 2.05], [-0.93, 1.77], [-0.93, -1.8],
+    ];
+    const body = flatShape(outline, 0x6dbcc5, 0.23);
+    body.position.z = BODY_HEIGHT;
+    const border = new THREE.LineLoop(
+        new THREE.BufferGeometry().setFromPoints(outline.map(([x, y]) => new THREE.Vector3(x, y, BODY_HEIGHT))),
+        new THREE.LineBasicMaterial({ color: 0x9ee6ec }),
+    );
+    const arrow = flatShape([
+        [-0.14, -1.37], [-0.14, -3.95], [-0.52, -3.95], [0, -4.8],
+        [0.52, -3.95], [0.14, -3.95], [0.14, -1.37],
+    ], FRONT_COLOR);
+    arrow.position.z = BODY_HEIGHT + 0.03;
+
+    const origin = new THREE.Mesh(
+        new THREE.RingGeometry(0.15, 0.25, 24),
+        new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide }),
+    );
+    group.add(body, border, arrow, origin);
+
+    const front = createLabel('LiDAR VF −Y · ĐẦU XE', '#ffd166', 20);
+    front.position.set(0, -4.8, BODY_HEIGHT + 0.12);
+
+    const left = createLabel('LiDAR VF +X · TRÁI', AXIS_COLORS[0], AXIS_LABEL_HEIGHT);
+    left.position.set(axisLength, 0, 0).add(axisOrigin);
+    left.center.set(1, 0.5);
+
+    const rear = createLabel('LiDAR VF +Y · ĐUÔI', AXIS_COLORS[1], AXIS_LABEL_HEIGHT);
+    rear.position.set(0, axisLength, 0).add(axisOrigin);
+    rear.center.set(0, 0.5);
+
+    const up = createLabel('LiDAR VF +Z · LÊN', AXIS_COLORS[2], AXIS_LABEL_HEIGHT);
+    up.position.set(0, 0, axisLength).add(axisOrigin);
+
+    group.add(front, left, rear, up, createCameras());
+
+    return group;
+}
