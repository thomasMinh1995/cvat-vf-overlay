+import React, {
+    useCallback, useEffect, useState, useSyncExternalStore,
+} from 'react';
+import { Canvas3d } from 'cvat-canvas3d-wrapper';
+
+const cameras = [
+    { name: 'cam01', angle: 0, label: 'cam01 0° · cam03 +5°', x: 110, y: 15 },
+    { name: 'cam03', angle: 5 },
+    { name: 'cam06', angle: 60, label: 'cam06 +60°', x: 61, y: 47 },
+    { name: 'cam07', angle: -60, label: 'cam07 −60°', x: 159, y: 47 },
+    { name: 'cam05', angle: 135, label: 'cam05 +135°', x: 59, y: 132 },
+    { name: 'cam08', angle: -135, label: 'cam08 −135°', x: 161, y: 132 },
+    { name: 'cam09', angle: 180, label: 'cam09 180°', x: 110, y: 159 },
+];
+
+function VfCuboidCenterReadout({ canvas }: { canvas: Canvas3d }): JSX.Element | null {
+    const subscribe = useCallback((notify: () => void) => {
+        const target = canvas.html().perspective;
+        target.addEventListener('canvas.vfcenter', notify);
+        return () => target.removeEventListener('canvas.vfcenter', notify);
+    }, [canvas]);
+    const getSnapshot = useCallback(() => canvas.getVfCuboidCenter(), [canvas]);
+    const center = useSyncExternalStore(subscribe, getSnapshot);
+    if (!center) return null;
+
+    return (
+        <div className='cvat-vf-cuboid-center'>
+            <strong>Tâm cuboid · LiDAR VF (m)</strong>
+            <div className='cvat-vf-cuboid-center-values'>
+                {(['X', 'Y', 'Z'] as const).map((axis, index) => (
+                    <span key={axis}>
+                        <b>{axis}</b>
+                        {' '}
+                        {(Math.round(center[index] * 100) / 100).toFixed(2)}
+                    </span>
+                ))}
+            </div>
+        </div>
+    );
+}
+
+export default function VfEgoPanel({ canvas, taskId }: { canvas: Canvas3d; taskId: number }): JSX.Element {
+    const settingKey = `cvat:show-vf-ego:task:${taskId}`;
+    const [visible, setVisible] = useState(() => localStorage.getItem(settingKey) === 'true');
+
+    useEffect(() => {
+        if (!visible) return undefined;
+
+        canvas.configure({ showVfEgoVehicle: true });
+        return () => canvas.configure({ showVfEgoVehicle: false });
+    }, [canvas, visible]);
+
+    const toggleOverlay = (): void => {
+        const nextVisible = !visible;
+        localStorage.setItem(settingKey, String(nextVisible));
+        setVisible(nextVisible);
+    };
+
+    return (
+        <section className='cvat-vf-ego-panel' aria-label='Định hướng xe LiDAR VF'>
+            <div className='cvat-vf-ego-header'>
+                <strong>Hệ trục LiDAR VF</strong>
+                <button
+                    type='button'
+                    aria-pressed={visible}
+                    title='Dùng cho task có hệ trục LiDAR VF'
+                    onClick={toggleOverlay}
+                >
+                    {visible ? 'Tắt VF' : 'Bật VF'}
+                </button>
+            </div>
+            {visible && (
+                <>
+                    <div>○ Xe gắn LiDAR · trục cố định</div>
+                    <div className='cvat-vf-ego-front'>↑ −Y đầu xe <span>· +Y đuôi xe</span></div>
+                    <div>+X trái · −X phải · +Z lên</div>
+                    <div><strong>Xe được gán nhãn</strong> · trục cuboid</div>
+                    <div><strong>+X đỏ</strong> đầu xe · <strong>−X</strong> đuôi xe</div>
+                    <VfCuboidCenterReadout canvas={canvas} />
+                    <details>
+                        <summary>Bố trí 7 camera minh họa</summary>
+                        <svg viewBox='0 0 220 165' role='img' aria-label='Bố trí camera minh họa, đầu xe hướng lên'>
+                            {cameras.map(({ name, angle, label, x, y }) => {
+                                const color = Math.abs(angle) < 90 ? '#77ddc1' : '#ff9f76';
+                                return (
+                                    <g key={name} fill={color}>
+                                        <path
+                                            d='M110 85V28m-3 4 3-4 3 4'
+                                            fill='none'
+                                            stroke={color}
+                                            strokeWidth='1.5'
+                                            transform={`rotate(${-angle} 110 85)`}
+                                        />
+                                        {label && (
+                                            <text x={x} y={y} textAnchor='middle' fontSize='10.5'>{label}</text>
+                                        )}
+                                    </g>
+                                );
+                            })}
+                            <rect x='95' y='60' width='30' height='51' rx='8' fill='#263d49' stroke='#9ee6ec' />
+                            <path d='M103 75l7-8 7 8z' fill='#ffd166' />
+                            <circle cx='110' cy='85' r='3' fill='none' stroke='white' />
+                        </svg>
+                    </details>
+                </>
+            )}
+        </section>
+    );
+}
